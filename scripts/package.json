    "validate": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs loop/validation.ts",
    "trace": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs loop/traceability.ts",
    "reviews": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs loop/reviews.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7",
    "yaml": "^2.7.0"
