{
  "name": "apexos-scripts",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ingest": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs ingest/index.ts",
    "ingest:scenario": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs ingest/index.ts --scenario leadership-conflict-q2",
    "loop": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs loop/executive-loop.ts",
