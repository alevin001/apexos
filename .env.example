# ApexOS hosted Supabase — copy to .env.local (never commit)
# Service role key: Supabase Dashboard → Project Settings → API → service_role

SUPABASE_URL=https://ahoabngdwnlcrdntmuqt.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

APEXOS_ENV=hosted
APEXOS_EXECUTIVE_SLUG=primary-executive

# Runtime Engine (Build 13)
APEXOS_RUNTIME_PORT=3020
APEXOS_RUNTIME_DRY_RUN=true
APEXOS_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# MCP Integration Layer (Build 14)
APEXOS_MCP_SERVER_NAME=apexos
APEXOS_MCP_PORT=3021
APEXOS_MCP_TOKEN=
APEXOS_MCP_LOG_LEVEL=info
APEXOS_MCP_RUNTIME_MODE=library
APEXOS_MCP_RUNTIME_ENDPOINT=http://localhost:3020

# Windows only — if npm/HTTPS fails with UNABLE_TO_VERIFY_LEAF_SIGNATURE, before npm install:
# NODE_OPTIONS=--use-system-ca
# Or run: cd scripts && .\install.ps1
