{
  "name": "apexos-runtime",
  "version": "0.19.0",
  "private": true,
  "type": "module",
  "description": "ApexOS Runtime Engine — executive intelligence orchestration (Build 19)",
  "scripts": {
    "start": "node run.mjs server/http-server.ts",
    "mcp": "node run.mjs mcp/server.ts",
    "mcp:http": "node run.mjs mcp/http-server.ts",
    "execute": "node run.mjs cli/execute.ts",
    "knowledge:ingest": "node run.mjs cli/knowledge-ingest.ts",
    "knowledge:ingest-file": "node run.mjs cli/knowledge-ingest.ts",
    "knowledge:spike-build19": "node run.mjs cli/build19-spikes.ts",
    "knowledge:fixtures-c": "node run.mjs cli/build19-fixtures-c.ts",
    "knowledge:fixtures-d": "node run.mjs cli/build19-fixtures-d.ts",
    "knowledge:fixtures-e": "node run.mjs cli/build19-fixtures-e.ts",
    "knowledge:fixtures-g": "node run.mjs cli/build19-fixtures-g.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/mcp/**/*.test.ts src/pipeline/**/*.test.ts src/pipeline/**/**/*.test.ts src/knowledge/**/*.test.ts",
    "test:mcp": "node --import tsx --test src/mcp/**/*.test.ts",
    "test:pipeline": "node --import tsx --test src/pipeline/**/*.test.ts src/pipeline/**/**/*.test.ts",
    "test:knowledge": "node --import tsx --test src/knowledge/**/*.test.ts"
  },
  "dependencies": {
    "@kenjiuno/msgreader": "^1.28.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "jszip": "^3.10.1",
    "pdf-parse": "^2.4.5",
    "postal-mime": "^2.7.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.13.10",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
